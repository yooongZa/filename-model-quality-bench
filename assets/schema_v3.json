{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "filename tags response v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "keywords",
    "reason",
    "place_name",
    "needs_review"
  ],
  "properties": {
    "keywords": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "place_name": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "needs_review": {
      "type": "boolean"
    }
  }
}
